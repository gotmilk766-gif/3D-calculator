rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(studioId) {
      return request.auth != null && request.auth.uid == studioId;
    }

    function isMember(studioId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/studios/$(studioId)/members/$(request.auth.uid));
    }

    match /studios/{studioId} {
      allow read, write: if isOwner(studioId) || isMember(studioId);

      match /members/{memberId} {
        allow read: if isOwner(studioId) || isMember(studioId);
        // Owner can add/remove anyone. A staff account can additionally
        // create ONLY their own membership doc, and only when they hold a
        // valid invite pointing at this exact studio — this is what lets
        // ensureMembership() self-register a newly-invited staff member on
        // their first login. Nobody but the owner can update/delete a
        // membership doc (so staff can't change roles or remove others).
        allow create: if isOwner(studioId) || (
          request.auth != null &&
          request.auth.uid == memberId &&
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/studioInvites/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/studioInvites/$(request.auth.token.email.lower())).data.studioId == studioId
        );
        allow update, delete: if isOwner(studioId);
      }

      match /orders/{orderId} {
        allow read, write: if isOwner(studioId) || isMember(studioId);
      }

      match /payments/{paymentId} {
        allow read, write: if isOwner(studioId) || isMember(studioId);
      }
    }

    // Invite lookup table, keyed by lowercase email.
    match /studioInvites/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.studioId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
