rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(studioId) {
      return request.auth != null && request.auth.uid == studioId;
    }

    function isMember(studioId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/studios/$(studioId)/members/$(request.auth.uid));
    }

    match /studios/{studioId} {
      allow read, write: if isOwner(studioId) || isMember(studioId);

      match /members/{memberId} {
        allow read: if isOwner(studioId) || isMember(studioId);
        allow write: if isOwner(studioId); // only the owner adds/removes members
      }

      match /orders/{orderId} {
        allow read, write: if isOwner(studioId) || isMember(studioId);
      }

      match /payments/{paymentId} {
        allow read, write: if isOwner(studioId) || isMember(studioId);
      }
    }

    // Invite lookup table, keyed by lowercase email.
    match /studioInvites/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.studioId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
